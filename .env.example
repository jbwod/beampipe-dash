# URL visible to the dashboard server, not necessarily to browsers.
BEAMPIPE_API_URL=http://127.0.0.1:8080

# Set true only when the dashboard is served over HTTPS.
BEAMPIPE_DASH_SECURE_COOKIES=false

# Public EAGLE editor base URL. This is embedded at build time.
NEXT_PUBLIC_EAGLE_URL=https://eagle.icrar.org
